# Environment Variables for BetterBetterHelp
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# 🔒 REQUIRED: OpenAI API Key (get from https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# 🌍 Environment (development/production/test)
NODE_ENV=development

# 🚪 Port (default: 3000)
PORT=3000

# Optional: External LLM Provider Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Database Configuration (for future implementation)
DATABASE_URL=your_database_url_here

# Application Settings (these are safe to expose)
NEXT_PUBLIC_APP_NAME=BetterBetterHelp
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=A brutally honest AI chat interface for questionable therapy advice

# 🔒 SECURITY NOTES:
# 1. Never commit .env.local to git
# 2. Use strong API keys
# 3. Rotate keys regularly
# 4. Monitor usage
# 5. Use HTTPS in production
